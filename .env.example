# Copy to .env, replace every credential, and keep .env out of version control.
# Optional image override used by docker-compose.ghcr.yml.
# WIREDRAFT_IMAGE=ghcr.io/arumes31/wiredraft:latest
POSTGRES_PASSWORD=replace-with-a-long-unique-database-password
WIREDRAFT_ADMIN_USER=admin
WIREDRAFT_ADMIN_PASSWORD=replace-with-a-long-unique-password
# Optional Base32 TOTP secret. Leave empty to enroll the administrator by QR on first login.
WIREDRAFT_ADMIN_TOTP_SECRET=
WIREDRAFT_GUEST_ENABLED=true
# Set true only when the application is reached through HTTPS.
WIREDRAFT_COOKIE_SECURE=false
# Native deployments may override the private photo root. Compose uses its media-data volume at /media.
# WIREDRAFT_MEDIA_DIR=data/media
