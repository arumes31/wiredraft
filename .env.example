# Copy to .env, replace every credential, and keep .env out of version control.

# Compose deployment. Pin WIREDRAFT_IMAGE to a release tag or digest in production.
COMPOSE_PROJECT_NAME=wiredraft
WIREDRAFT_IMAGE=ghcr.io/arumes31/wiredraft:latest
POSTGRES_IMAGE=postgres:17-alpine@sha256:742f40ea20b9ff2ff31db5458d127452988a2164df9e17441e191f3b72252193
WIREDRAFT_BIND_ADDRESS=0.0.0.0
WIREDRAFT_PUBLISHED_PORT=8080

# Bundled PostgreSQL container.
POSTGRES_DB=wiredraft
POSTGRES_USER=wiredraft
POSTGRES_PASSWORD=replace-with-a-long-unique-database-password

# WireDraft database connection. Keep these aligned with POSTGRES_DB and
# POSTGRES_USER for the bundled database. DATABASE_URL overrides the PG* values.
DATABASE_URL=
PGHOST=postgres
PGPORT=5432
PGDATABASE=wiredraft
PGUSER=wiredraft
# Leave empty to reuse POSTGRES_PASSWORD, or set it for a different database.
PGPASSWORD=

# WireDraft HTTP server and private media storage. When PORT changes, update
# HEALTHCHECK_URL to use the same container port.
PORT=8080
HEALTHCHECK_URL=http://127.0.0.1:8080/api/v1/health
WIREDRAFT_MEDIA_DIR=/media
LOG_LEVEL=info
LOG_FORMAT=json

# Bootstrap authentication and access policy.
WIREDRAFT_ADMIN_USER=admin
WIREDRAFT_ADMIN_PASSWORD=replace-with-a-long-unique-password
# Optional Base32 TOTP secret. Leave empty to enroll the administrator by QR on first login.
WIREDRAFT_ADMIN_TOTP_SECRET=
WIREDRAFT_GUEST_ENABLED=true
# Set true only when the application is reached through HTTPS. Entra login
# requires this to be true.
WIREDRAFT_COOKIE_SECURE=false

# Optional single-tenant Microsoft Entra login. The callback is reached by the
# user's browser over your private LAN/VPN; WireDraft itself needs outbound
# HTTPS access to Microsoft. Mount the client-secret file read-only into the
# container before enabling these settings. When enabling Entra, also set
# WIREDRAFT_COOKIE_SECURE=true above or startup validation will reject it.
WIREDRAFT_ENTRA_ENABLED=false
WIREDRAFT_ENTRA_TENANT_ID=
WIREDRAFT_ENTRA_CLIENT_ID=
WIREDRAFT_ENTRA_CLIENT_SECRET_FILE=/run/secrets/wiredraft_entra_client_secret
WIREDRAFT_ENTRA_REDIRECT_URL=https://wiredraft.internal/api/v1/auth/entra/callback
