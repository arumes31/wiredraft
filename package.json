{
  "name": "wiredraft-quality",
  "private": true,
  "type": "module",
  "scripts": {
    "minify:js": "node scripts/minify-js.mjs --source web/static/js --output .quality-data/minified-js",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test web/*_test.mjs",
    "test:coverage": "c8 --all --include=web/static/js/*.js --exclude=web/static/js/app.js --exclude=web/static/js/canvas.js --reporter=text --reporter=lcov --check-coverage --lines=80 --functions=80 --branches=80 node --test web/*_test.mjs",
    "test:e2e": "playwright test --project=chromium --project=firefox --project=webkit",
    "test:edge": "playwright test --project=edge",
    "test:visual": "playwright test --config=playwright.visual.config.mjs --project=chromium",
    "test:visual:update": "playwright test --config=playwright.visual.config.mjs --project=chromium --update-snapshots",
    "test:a11y": "playwright test e2e/accessibility.spec.mjs --project=chromium"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "c8": "^12.0.0",
    "esbuild": "0.28.1"
  }
}
